# TheHulk - ESP32-S3-DevKitC-1 N16R8 (16 MB quad flash, 8 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Logs on the UART port, and also on the native USB port of the DevKit
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

CONFIG_FREERTOS_HZ=1000

# Fast boot: the cartridge must be ready before TOS reads it (fastest case measured:
# ST with TOS 1.04 and no hard disk, ~0.67 s after power-on)
CONFIG_SPIRAM_MEMTEST=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y

# Quiet startup: log lines on the UART cost ~5 ms each on the boot path. The app
# raises the level to INFO in app_main().
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
